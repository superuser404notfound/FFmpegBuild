         unsigned int extradata_syncword;
 
@@ -1073,10 +1410,41 @@ static int parse_frame(DCAXllDecoder *s, const uint8_t *data, int size, DCAExssA
 
         extradata_syncword = show_bits_long(&s->gb, 32);
 
