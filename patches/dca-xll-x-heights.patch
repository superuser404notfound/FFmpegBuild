+// The extension at the end of a DTS:X frame in the standard presentation is a
+// 22-byte header followed by a regular XLL channel set with its own NAVI table,
+// segmented like the frame's channel sets. Its four channels are the front and
+// rear height pairs; each is also folded into the 7.1 bed speaker below it at
+// -3 dB, and the bed is output as coded.
+static int parse_x_chset(DCAXllDecoder *s, DCAExssAsset *asset, int max_tail_bytes);
+
+static int parse_x_heights(DCAXllDecoder *s, DCAExssAsset *asset)
+{
+    if (s->nfreqbands != 1)
+        return AVERROR_PATCHWELCOME;
+
+    skip_bits_long(&s->gb, DCA_XLL_X_HEADER_SIZE * 8);
+    if (get_bits_left(&s->gb) < 0)
+        return AVERROR_INVALIDDATA;
+
+    // A two-byte trailer and up to three bytes of dword padding follow
+    return parse_x_chset(s, asset, 5);
+}
+
+// The alternate presentations (IMAX-labelled streams among them) put one to
+// five object channels and then the same four fixed heights as the standard
+// presentation behind their own syncwords, after a CRC-protected prefix and a
+// control block. Only the height channel set is located and decoded here: the
+// prefix is only checked against its CRC and the object channels are skipped.
+// The heights carry their own segment geometry, read from the control block
+// in front of their header. The layout follows the public analysis in
+// harletty-bridge's dca crate.
+#define DCA_XLL_X_ALT_FRAME_SAMPLES     512
+#define DCA_XLL_X_ALT_MAX_PREFIX        96
+#define DCA_XLL_X_ALT_MIN_PREFIX        16
+#define DCA_XLL_X_ALT_MAX_INTERSTITIAL  20
+
+static const uint8_t x_alt_marker_tail[5] = { 0x34, 0x38, 0x8c, 0x4f, 0x00 };
+
+typedef struct DCAXllXAltGeometry {
+    int nframesegs_log2;
+    int nsegsamples_log2;
+    int seg_size_nbits;
+} DCAXllXAltGeometry;
+
+static int x_alt_crc_ok(const uint8_t *buf, int size)
+{
+    return !av_crc(av_crc_get_table(AV_CRC_16_CCITT), 0xffff, buf, size);
+}
+
+static int x_alt_geometry_at(const uint8_t *ctl, int size, int bit, DCAXllXAltGeometry *g)
+{
+    GetBitContext gb;
+
+    if (bit + 13 > size * 8 || init_get_bits8(&gb, ctl, size) < 0)
+        return 0;
+    skip_bits_long(&gb, bit);
+    g->nframesegs_log2  = get_bits(&gb, 4);
+    g->nsegsamples_log2 = get_bits(&gb, 4);
+    g->seg_size_nbits   = get_bits(&gb, 5) + 1;
+    return g->nframesegs_log2 <= 3 &&
+           g->nframesegs_log2 + g->nsegsamples_log2 == 9 &&
+           g->seg_size_nbits >= 4 && g->seg_size_nbits <= 20;
+}
+
+// The one bit offset in [first, last] that reads as a valid geometry
+static int x_alt_unique_geometry(const uint8_t *ctl, int size, int first, int last,
+                                 DCAXllXAltGeometry *g)
+{
+    DCAXllXAltGeometry tmp;
+    int bit, found = -1;
+
+    for (bit = first; bit <= last; bit++) {
+        if (!x_alt_geometry_at(ctl, size, bit, &tmp))
+            continue;
+        if (found >= 0)
+            return AVERROR_INVALIDDATA;
+        found = bit;
+        *g = tmp;
+    }
+    return found >= 0 ? found : AVERROR_INVALIDDATA;
+}
+
+// Channel count of a CRC-valid channel set header at offset, or 0
+static int x_alt_header_at(const uint8_t *buf, int size, int offset)
+{
+    GetBitContext gb;
+    int header_size, nchannels, pcm_bit_res, storage_bit_res, freq_index;
+
+    if (offset < 0 || offset + 4 > size || init_get_bits8(&gb, buf + offset, size - offset) < 0)
+        return 0;
+    header_size = get_bits(&gb, 10) + 1;
+    nchannels   = get_bits(&gb, 4) + 1;
+    if (nchannels > DCA_XLL_CHANNELS_MAX)
+        return 0;
+    skip_bits(&gb, nchannels);
+    pcm_bit_res     = get_bits(&gb, 5) + 1;
+    storage_bit_res = get_bits(&gb, 5) + 1;
+    freq_index      = get_bits(&gb, 4);
+    if (header_size > size - offset || pcm_bit_res > storage_bit_res ||
+        (storage_bit_res != 16 && storage_bit_res != 20 && storage_bit_res != 24) ||
+        freq_index != 12 || get_bits(&gb, 2) || get_bits(&gb, 2) ||
+        !x_alt_crc_ok(buf + offset, header_size))
+        return 0;
+    return nchannels;
+}
+
+// Offset of the height channel set in an alternate payload and its geometry
+static int x_alt_locate_heights(const uint8_t *buf, int size, DCAXllXAltGeometry *g)
+{
+    static const uint8_t inner_suffix[6] = { 0x02, 0x34, 0x38, 0x8c, 0x4f, 0x00 };
+    DCAXllXAltGeometry first_geometry;
+    GetBitContext gb;
+    const uint8_t *ctl;
+    int profile = buf[3] & 0x0f, prefix = -1, set_mask = 0, ctl_start, ctl_size;
+    int geometry_end, common_bit, first_channels, field_width, nominal;
+    int i, offset, found, window, suffix;
+
+    switch (profile) {
+    case 0x0: geometry_end = 25; break;
+    case 0x1: geometry_end = 25; break;
+    case 0x3: geometry_end = 31; break;
+    case 0x4: geometry_end = 26; break;
+    default:  return AVERROR_PATCHWELCOME;
+    }
+
+    // CRC-protected prefix, ended by a mask of the sets that follow and a marker
+    for (i = DCA_XLL_X_ALT_MIN_PREFIX; i < FFMIN(size, DCA_XLL_X_ALT_MAX_PREFIX); i++) {
+        if (i + 6 > size)
+            break;
+        if (memcmp(buf + i + 1, x_alt_marker_tail, 5) || (buf[i] & ~3) || !(buf[i] & 1) ||
+            !x_alt_crc_ok(buf, i))
+            continue;
+        if (prefix >= 0)
+            return AVERROR_INVALIDDATA;
+        prefix   = i;
+        set_mask = buf[i];
+    }
+    if (prefix < 0)
+        return AVERROR_INVALIDDATA;
+    // The object-only variant carries no heights
+    if (!(set_mask & 2))
+        return AVERROR_PATCHWELCOME;
+
+    ctl_start = prefix + 6;
+    if (ctl_start >= size)
+        return AVERROR_INVALIDDATA;
+    if (buf[ctl_start] == 0xb2)
+        ctl_size = 7;
+    else if (buf[ctl_start] >= 0xc2 && buf[ctl_start] <= 0xc6)
+        ctl_size = 8;
+    else
+        return AVERROR_INVALIDDATA;
+    if (ctl_start + ctl_size > size)
+        return AVERROR_INVALIDDATA;
+    ctl = buf + ctl_start;
+
+    common_bit = x_alt_unique_geometry(ctl, ctl_size, 18, geometry_end, &first_geometry);
+    if (common_bit < 0)
+        return common_bit;
+
+    // The object channel set: one to five channels by profile
+    first_channels = x_alt_header_at(buf, size, ctl_start + ctl_size);
+    if (!((profile == 0x0 && (first_channels == 1 || first_channels == 3)) ||
+          (profile == 0x1 && first_channels == 2) ||
+          (profile == 0x3 && first_channels == 4) ||
+          (profile == 0x4 && first_channels == 5)))
+        return AVERROR_INVALIDDATA;
+
+    // The control block states where the height header sits, in two-byte units
+    field_width = common_bit - 14;
+    if (field_width < 1 || init_get_bits8(&gb, ctl, ctl_size) < 0)
+        return AVERROR_INVALIDDATA;
+    skip_bits(&gb, 9);
+    nominal = get_bits_long(&gb, field_width) * 2 + ctl_start + 12;
+    offset = -1;
+    for (i = 0; i < 2; i++) {
+        if (x_alt_header_at(buf, size, nominal - i) != 4)
+            continue;
+        if (offset >= 0)
+            return AVERROR_INVALIDDATA;
+        offset = nominal - i;
+    }
+    if (offset < 0)
+        return AVERROR_INVALIDDATA;
+
+    // The heights' own control block ends right in front of their header
+    window = FFMAX(offset - 24, 0);
+    suffix = -1;
+    for (i = window; i + 6 <= offset; i++)
+        if (!memcmp(buf + i, inner_suffix, 6))
+            suffix = i;
+    if (suffix < 0 || offset - (suffix + 6) < 8 || offset - (suffix + 6) > 9)
+        return AVERROR_INVALIDDATA;
+    found = x_alt_unique_geometry(buf + suffix + 6, offset - (suffix + 6),
+                                  profile == 0x0 ? 18 : 19, 26, g);
+    if (found < 0)
+        return found;
+
+    return offset;
+}
+
+static int parse_x_alt_heights(DCAXllDecoder *s, DCAExssAsset *asset)
+{
+    int x_byte = get_bits_count(&s->gb) / 8;
+    const uint8_t *buf = s->gb.buffer + x_byte;
+    int size = s->frame_size - x_byte;
+    int nframesegs, nsegsamples, nsegsamples_log2, seg_size_nbits;
+    int band_crc_present, scalable_lsbs, fixed_lsb_width, nchsets;
+    DCAXllXAltGeometry g;
+    int offset, ret;
+
+    if (s->nfreqbands != 1 || s->nframesamples != DCA_XLL_X_ALT_FRAME_SAMPLES || size < 8)
+        return AVERROR_PATCHWELCOME;
+    if ((offset = x_alt_locate_heights(buf, size, &g)) < 0)
+        return offset;
+
+    nframesegs       = s->nframesegs;
+    nsegsamples      = s->nsegsamples;
+    nsegsamples_log2 = s->nsegsamples_log2;
+    seg_size_nbits   = s->seg_size_nbits;
+    band_crc_present = s->band_crc_present;
+    scalable_lsbs    = s->scalable_lsbs;
+    fixed_lsb_width  = s->fixed_lsb_width;
+    nchsets          = s->nchsets;
+
+    s->nframesegs       = 1 << g.nframesegs_log2;
+    s->nsegsamples_log2 = g.nsegsamples_log2;
+    s->nsegsamples      = 1 << g.nsegsamples_log2;
+    s->seg_size_nbits   = g.seg_size_nbits;
+    s->band_crc_present = 0;
+    s->scalable_lsbs    = 0;
+    s->fixed_lsb_width  = 0;
+    s->nchsets          = 1;
+    s->x_alt            = 1;
+
+    skip_bits_long(&s->gb, offset * 8);
+    ret = parse_x_chset(s, asset, DCA_XLL_X_ALT_MAX_INTERSTITIAL);
+
+    s->nframesegs       = nframesegs;
+    s->nsegsamples      = nsegsamples;
+    s->nsegsamples_log2 = nsegsamples_log2;
+    s->seg_size_nbits   = seg_size_nbits;
+    s->band_crc_present = band_crc_present;
+    s->scalable_lsbs    = scalable_lsbs;
+    s->fixed_lsb_width  = fixed_lsb_width;
+    s->nchsets          = nchsets;
+    s->x_alt            = 0;
+    return ret;
+}
+
+// The height channel set from its header on: its NAVI table and its segments
+static int parse_x_chset(DCAXllDecoder *s, DCAExssAsset *asset, int max_tail_bytes)
+{
+    DCAXllChSet *c = &s->x_chset;
+    int ret, seg, navi_pos, band_pos, navi[1024];
+
+    c->hier_ofs = 0;
+    if ((ret = chs_parse_header(s, c, asset)) < 0)
+        return ret;
+    if (c->residual_encode != (1 << c->nchannels) - 1) {
+        avpriv_request_sample(s->avctx, "DTS:X height channels coded against the core");
+        return AVERROR_PATCHWELCOME;
+    }
+
+    navi_pos = get_bits_count(&s->gb);
+    for (seg = 0; seg < s->nframesegs; seg++) {
+        navi[seg] = get_bits_long(&s->gb, s->seg_size_nbits);
+        if (navi[seg] < 0 || navi[seg] >= s->frame_size) {
+            av_log(s->avctx, AV_LOG_ERROR, "Invalid DTS:X NAVI segment size (%d bytes)\n", navi[seg]);
+            return AVERROR_INVALIDDATA;
+        }
+        navi[seg]++;
+    }
+    skip_bits(&s->gb, -get_bits_count(&s->gb) & 7);
+    skip_bits(&s->gb, 16);
+    if (ff_dca_check_crc(s->avctx, &s->gb, navi_pos, get_bits_count(&s->gb))) {
+        av_log(s->avctx, AV_LOG_ERROR, "Invalid DTS:X NAVI checksum\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    if ((ret = chs_alloc_msb_band_data(s, c)) < 0)
+        return ret;
+    if ((ret = chs_alloc_lsb_band_data(s, c)) < 0)
+        return ret;
+
+    band_pos = get_bits_count(&s->gb);
+    for (seg = 0; seg < s->nframesegs; seg++) {
+        band_pos += navi[seg] * 8;
+        if (band_pos > s->frame_size * 8) {
+            av_log(s->avctx, AV_LOG_ERROR, "Invalid DTS:X NAVI position\n");
+            return AVERROR_INVALIDDATA;
+        }
+        if ((ret = chs_parse_band_data(s, c, 0, seg, band_pos)) < 0)
+            return ret;
+        skip_bits_long(&s->gb, band_pos - get_bits_count(&s->gb));
+    }
+
+    if (s->frame_size * 8 - band_pos > max_tail_bytes * 8) {
+        av_log(s->avctx, AV_LOG_ERROR, "DTS:X height channel set ends %d bytes before its frame\n",
+               s->frame_size - band_pos / 8);
+        return AVERROR_INVALIDDATA;
+    }
+
+    return 0;
+}
+
 static int parse_frame(DCAXllDecoder *s, const uint8_t *data, int size, DCAExssAsset *asset)
 {
+    DCAContext *dca = s->avctx->priv_data;
